# Use API-key authentication instead of a persisted ChatGPT login.
OPENAI_API_KEY=

# Base URL of an OpenAI-compatible API. Include the provider's required API path.
OPENAI_BASE_URL=

# Request protocol supported by the provider: `chat` or `responses`.
OPENAI_WIRE_API=chat

# Provider-specific model identifier. `--model` and an explicitly selected
# config profile override this value.
OPENAI_MODEL=

# Reasoning level: minimal, low, medium, high, or xhigh. Defaults to low.
OPENAI_REASONING_EFFORT=low
