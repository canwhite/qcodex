# Use API-key authentication instead of a persisted ChatGPT login.
OPENAI_API_KEY=

# Base URL of an OpenAI-compatible API. Include the provider's required API path.
OPENAI_BASE_URL=

# Request protocol supported by the provider: `chat` or `responses`. The
# provider must support OpenAI-compatible function calling for local tools.
OPENAI_WIRE_API=chat

# Provider-specific model identifier. `--model` and an explicitly selected
# config profile override this value.
OPENAI_MODEL=

# Shell, file, browser, MCP, and approval tools are local and provider-neutral.
# Built-in external subagents are not advertised to third-party compatible
# endpoints; configure a runnable local [[agents]] command in config.toml to
# opt in to subagents.

# Reasoning level: minimal, low, medium, high, or xhigh. Defaults to low.
OPENAI_REASONING_EFFORT=low
